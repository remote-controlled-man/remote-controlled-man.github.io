---
import Shell from '../layouts/Shell.astro';
---

<Shell
  locale="en"
  view="home"
  title="Page not found"
  description="Return to Steven Huang's personal website."
  noindex
>
  <section class="page-intro">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p>The address may have changed. You can return to the homepage.</p>
    <p lang="zh-CN">找不到这个页面，地址可能已经改变。</p>
    <p>
      <a class="text-link" href="/">
        Back to home <span aria-hidden="true">→</span>
      </a>
    </p>
    <p>
      <a class="text-link" href="/zh/" lang="zh-CN">
        返回中文首页 <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Shell>
